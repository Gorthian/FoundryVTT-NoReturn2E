<div class="nr-dialog">
  <div class="form-group"><label>{{localize "NR.Damage.Amount"}}</label><input type="number" name="amount" value="10" min="0" autofocus></div>
  <div class="form-group">
    <label>{{localize "NR.Damage.Zones"}}</label>
    <select name="zoneMode">
      <option value="random">{{localize "NR.Damage.Random"}}</option>
      <option value="single">{{localize "NR.Damage.Single"}}</option>
      <option value="all">{{localize "NR.Damage.All"}}</option>
    </select>
  </div>
  <div class="form-group"><label>{{localize "NR.Zone.Zone"}}</label>
    <select name="zone">{{#each zones as |z key|}}<option value="{{key}}" {{#if (eq key "7")}}selected{{/if}}>{{key}}: {{z.label}}</option>{{/each}}</select></div>
  <div class="form-group"><label>{{localize "NR.Weapon.DamageType"}}</label>
    <select name="damageType">{{selectOptions types selected="wucht"}}</select></div>
  <div class="form-group"><label>{{localize "NR.Weapon.Pierce"}}</label>
    <select name="pierce">{{selectOptions pierce}}</select></div>
  <div class="form-group"><label>{{localize "NR.Damage.Continuous"}}: {{localize "NR.Damage.ResistMalus"}}</label><input type="number" name="resistMalus" value="0" min="0"></div>
  <div class="form-group"><label>NL</label><input type="checkbox" name="nonLethal"></div>
  <div class="form-group"><label>{{localize "NR.Damage.Structure"}}</label><input type="checkbox" name="structure"></div>
  <div class="form-group"><label data-tooltip="{{localize 'NR.Damage.DirectHint'}}">{{localize "NR.Damage.Direct"}}</label><input type="checkbox" name="direct"></div>
  <p class="nr-hint">{{localize "NR.Damage.ManualHint"}}</p>
</div>
