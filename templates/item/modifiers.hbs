<section class="tab nr-item-modifiers {{tab.cssClass}}" data-group="primary" data-tab="modifiers">
  <p class="nr-hint">{{localize "NR.Modifier.Hint"}}</p>
  <ol class="nr-list nr-modifiers">
    {{#each system.modifiers as |m i|}}
    <li class="nr-modifier">
      <select name="system.modifiers.{{i}}.target">{{selectOptions @root.options.modifierTargets selected=m.target}}</select>
      <input type="number" name="system.modifiers.{{i}}.value" value="{{m.value}}" step="any">
      {{#if @root.isType.styleSkill}}<input type="number" name="system.modifiers.{{i}}.level" value="{{m.level}}" min="0" max="3" data-tooltip="{{localize 'NR.Modifier.FromLevel'}}" placeholder="{{localize 'NR.Style.Level'}}">{{/if}}
      <a data-action="removeModifier" data-index="{{i}}"><i class="fa-solid fa-trash"></i></a>
    </li>
    {{else}}<li class="nr-empty">{{localize "NR.Modifier.None"}}</li>{{/each}}
  </ol>
  <a class="nr-btn" data-action="addModifier"><i class="fa-solid fa-plus"></i> {{localize "NR.Modifier.Add"}}</a>
</section>
