<header class="nr-header">
  <img class="nr-portrait" src="{{actor.img}}" data-action="editImage" data-edit="img" alt="{{actor.name}}" data-tooltip="{{localize 'NR.Sheet.Portrait'}}">
  <div class="nr-header-main">
    <div class="nr-brand" aria-hidden="true">NORETURN <span>Das Endzeit Rollenspiel</span></div>
    <input class="nr-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'NR.Sheet.Name'}}">
    <div class="nr-header-line">
      <label>{{localize "NR.Detail.species"}}
        <input type="text" name="system.details.species" value="{{system.details.species}}" placeholder="Mensch, Evo …">
      </label>
      <label>{{localize "NR.Detail.concept"}}
        <input type="text" name="system.details.concept" value="{{system.details.concept}}" placeholder="Jack, Riot, Softie …">
      </label>
      {{#if isNpc}}
      <label>{{localize "NR.Detail.threat"}}
        <input type="text" name="system.threat" value="{{system.threat}}">
      </label>
      {{/if}}
    </div>
    <div class="nr-status-strip nr-vitals">
      <div class="nr-stat" data-tooltip="{{localize 'NR.Status.HealthHint'}}">
        <span class="nr-stat-label">{{localize "NR.Status.Health"}}</span>
        <div class="nr-bar"><div class="nr-bar-fill hp" style="width: {{nrPct system.health.value system.health.max}}%"></div></div>
        <span class="nr-stat-value nr-stat-big">{{system.health.value}}<small>/{{system.health.max}}</small></span>
      </div>
      <div class="nr-stat nr-adrenalin">
        <span class="nr-stat-label">{{localize "NR.Special.adrenalin"}}</span>
        <span class="nr-pips">
          {{#each adrenalinPips}}<i class="fa-solid fa-bolt {{#if used}}used{{/if}}"></i>{{/each}}
        </span>
        <a data-action="adrenalin" data-kind="adrenalin" data-delta="1" data-tooltip="{{localize 'NR.Sheet.UseAdrenalin'}}"><i class="fa-solid fa-minus"></i></a>
        <a data-action="adrenalin" data-kind="adrenalin" data-delta="-1" data-tooltip="{{localize 'NR.Sheet.RestoreAdrenalin'}}"><i class="fa-solid fa-plus"></i></a>
      </div>
      <div class="nr-stat {{#if system.malus.total}}nr-warn{{/if}}" data-tooltip="{{localize 'NR.Status.MalusHint'}}">
        <span class="nr-stat-label">{{localize "NR.Status.Malus"}}</span>
        <span class="nr-stat-value nr-stat-big">−{{system.malus.total}}<small>W</small></span>
      </div>
      <div class="nr-stat">
        <span class="nr-stat-label">{{localize "NR.Status.Movement"}}</span>
        <span class="nr-stat-value nr-stat-big">{{system.movement}}<small>m</small></span>
      </div>
      <div class="nr-stat" data-tooltip="{{system.org.band.label}}">
        <span class="nr-stat-label">{{localize "NR.Status.Organism"}}</span>
        <span class="nr-stat-value nr-stat-big">{{system.org.value}}</span>
      </div>
      <div class="nr-stat" data-tooltip="{{system.psy.band.label}}">
        <span class="nr-stat-label">{{localize "NR.Status.Psyche"}}</span>
        <span class="nr-stat-value nr-stat-big">{{system.psy.value}}</span>
      </div>
      <a class="nr-btn small" data-action="rest" data-tooltip="{{localize 'NR.Sheet.RestHint'}}"><i class="fa-solid fa-bed"></i> {{localize "NR.Sheet.Rest"}}</a>
    </div>
    {{#if system.lethalDestroyed}}<div class="nr-alert dead"><i class="fa-solid fa-skull"></i> {{localize "NR.Status.LethalZone"}}</div>
    {{else if system.unconscious}}<div class="nr-alert"><i class="fa-solid fa-bed-pulse"></i> {{localize "NR.Status.Unconscious"}}</div>
    {{else if system.immobile}}<div class="nr-alert"><i class="fa-solid fa-person-cane"></i> {{localize "NR.Status.Immobile"}}</div>{{/if}}
  </div>
</header>
