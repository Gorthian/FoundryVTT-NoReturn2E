<section class="tab nr-tab-psi {{tab.cssClass}}" data-group="primary" data-tab="psi">
  {{#unless psiAllowed}}<p class="nr-hint"><i class="fa-solid fa-circle-info"></i> {{localize "NR.Psi.NotGifted"}}</p>{{/unless}}
  <div class="nr-psi-bar">
    <div class="nr-stat"><span class="nr-stat-label">{{localize "NR.Psi.CollectedKs"}}</span>
      <input type="number" name="system.combat.psiCollected" value="{{system.combat.psiCollected}}" min="0"></div>
    <a class="nr-btn" data-action="collectPower" data-tooltip="{{localize 'NR.Psi.CollectHint'}}"><i class="fa-solid fa-hand-sparkles"></i> {{localize "NR.Psi.Collect"}}</a>
    <a class="nr-btn" data-action="psiFail" data-tooltip="{{localize 'NR.Psi.FailHint'}}"><i class="fa-solid fa-burst"></i> {{localize "NR.Psi.FailTable"}}</a>
    {{#if system.combat.zeitpool}}<span class="nr-chip psi">{{localize "NR.Psi.Zeitpool"}}: {{system.combat.zeitpool}}/{{system.combat.zeitpoolMax}}</span>{{/if}}
    {{#if system.malus.hold}}<span class="nr-chip warn">{{localize "NR.Psi.HoldMalus"}}: −{{system.malus.hold}}W</span>{{/if}}
    <a class="nr-add" data-action="createItem" data-type="psiPower" data-tooltip="{{localize 'NR.Psi.AddPower'}}"><i class="fa-solid fa-plus"></i> {{localize "TYPES.Item.psiPower"}}</a>
  </div>

  {{#each powers as |p|}}
  <div class="nr-psi-power tier-{{p.tier}}" data-item-id="{{p.item.id}}">
    <div class="nr-psi-power-head draggable" data-item-id="{{p.item.id}}">
      <img src="{{p.item.img}}" alt="">
      <h4 class="nr-subhead">{{p.item.name}} <span class="nr-chip">Ebene {{p.tier}}</span></h4>
      <label>{{localize "NR.Psi.Level"}} <input type="number" data-item-field="system.value" value="{{p.item.system.value}}" min="0"></label>
      {{#if ../isCharacter}}<a data-action="advance" data-type="psi" data-tooltip="{{p.cost}} EP"><i class="fa-solid fa-circle-up"></i></a>{{/if}}
      {{#if p.hmo}}
      <a data-action="toggleActive" data-tooltip="{{localize 'NR.Psi.ToggleActive'}}"><i class="fa-solid fa-power-off {{#unless p.item.system.active}}nr-dim{{/unless}}"></i></a>
      {{#if p.item.system.bloodAction}}<a data-action="bloodPower" data-tooltip="{{localize 'NR.Psi.BloodUse'}} ({{p.item.system.bloodCost}} {{localize 'NR.Psi.BloodPoints'}})"><i class="fa-solid fa-droplet"></i></a>{{/if}}
      {{else}}
      <span class="nr-hint">{{localize "NR.Psi.AppsKnown"}}: {{p.apps.length}}/{{p.item.system.value}}</span>
      <a data-action="createItem" data-type="psiApp" data-power="{{p.item.system.key}}" data-tooltip="{{localize 'NR.Psi.AddApp'}}"><i class="fa-solid fa-plus"></i></a>
      {{/if}}
      <a data-action="editItem"><i class="fa-solid fa-pen"></i></a>
      <a data-action="deleteItem"><i class="fa-solid fa-trash"></i></a>
    </div>
    <ol class="nr-list nr-psi-apps">
      {{#each p.apps as |a|}}
      <li class="nr-item-row draggable {{#if a.item.system.held}}held{{/if}}" data-item-id="{{a.item.id}}">
        <div class="nr-item-main">
          <a class="nr-btn tiny" data-action="useItem" data-tooltip="{{localize 'NR.Psi.Cast'}}"><i class="fa-solid fa-brain"></i></a>
          <a class="nr-item-name" data-action="toggleDescription">{{a.item.name}}</a>
          <span class="nr-item-stat">{{a.diff}} {{a.item.system.min}}–{{a.item.system.max}}</span>
          {{#if a.item.system.hold}}<a class="nr-item-stat" data-action="toggleHeld" data-tooltip="{{localize 'NR.Psi.ToggleHeld'}}"><i class="fa-solid fa-hourglass-half {{#unless a.item.system.held}}nr-dim{{/unless}}"></i> H{{a.hold}}</a>{{/if}}
          {{#if a.item.system.defensive}}<i class="fa-solid fa-shield-halved nr-def" data-tooltip="{{localize 'NR.Sheet.Defensive'}}"></i>{{/if}}
          <a data-action="editItem"><i class="fa-solid fa-pen"></i></a>
          <a data-action="deleteItem"><i class="fa-solid fa-trash"></i></a>
        </div>
        <div class="nr-item-details">{{a.item.system.effect}}</div>
      </li>
      {{/each}}
    </ol>
  </div>
  {{else}}
  <p class="nr-empty">{{localize "NR.Psi.NoPowers"}}</p>
  {{/each}}

  {{#if orphanApps.length}}
  <h3 class="nr-section-title">{{localize "NR.Psi.OrphanApps"}}</h3>
  <ol class="nr-list">
    {{#each orphanApps as |a|}}
    <li class="nr-item-row draggable" data-item-id="{{a.item.id}}">
      <div class="nr-item-main">
        <a class="nr-item-name" data-action="editItem">{{a.item.name}}</a>
        <span class="nr-item-stat">{{a.power}} · {{a.diff}}</span>
        <a data-action="deleteItem"><i class="fa-solid fa-trash"></i></a>
      </div>
    </li>
    {{/each}}
  </ol>
  {{/if}}
</section>
